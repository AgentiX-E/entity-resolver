{
  "name": "@agentix-e/entity-resolver",
  "version": "0.0.0",
  "private": true,
  "description": "Entity Resolver for Node.js and browser — stateless pure computation engine with WASM acceleration",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentiX-E/entity-resolver.git"
  },
  "license": "MIT",
  "author": "Lambertyan",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --check '**/*.ts'",
    "format:fix": "prettier --write '**/*.ts'",
    "clean": "pnpm -r clean",
    "test:bench": "vitest run --config vitest.bench.config.ts",
    "test:bench:coverage": "vitest run --config vitest.bench.config.ts --coverage",
    "bench": "node --import tsx benchmarks/run.ts",
    "bench:compare": "node --import tsx benchmarks/run.ts --compare-only",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "tsx docs/scripts/generate-api.ts",
    "changeset": "changeset",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm format"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^2.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "csv-parse": "^7.0.1",
    "duckdb": "^1.4.4"
  }
}
